# =====================================================
# Stationery World — environment configuration
# =====================================================
# Copy this file to .env (for local dev) and fill in real
# values. Vite only exposes variables prefixed VITE_ to the
# browser bundle — never put secrets here (this file ships
# to the browser).

# Base URL of your backend API (no trailing slash).
# Ignored while VITE_USE_MOCK_API=true.
VITE_API_BASE_URL=http://localhost:5000/api

# true  = app runs fully self-contained on mock/demo data (current state)
# false = app calls VITE_API_BASE_URL for everything (see BACKEND_API.md)
VITE_USE_MOCK_API=true
