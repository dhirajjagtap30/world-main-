# =====================================================
# Stationery World — backend environment configuration
# =====================================================
# Copy this file to .env and fill in real values before
# running in anything other than local dev.

# Port the HTTP server listens on.
PORT=5000

# Secret used to sign JWTs. MUST be changed before going to
# production — generate one with e.g. `openssl rand -hex 32`.
JWT_SECRET=change-this-to-a-long-random-string

# How long an issued token stays valid (jsonwebtoken "expiresIn" format).
JWT_EXPIRES_IN=7d

# Comma-separated list of origins allowed to call this API
# (the frontend's dev server and/or production domain).
CORS_ORIGIN=http://localhost:5173

# Path to the JSON file used as the database (see src/db.js).
# Swap src/db.js for a real database later — every route only
# talks to db.js, never to the file directly.
DB_FILE=./data/db.json
